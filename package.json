{
  "name": "expo-50sdk-template",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "android": "npm --prefix apps/mobile run android",
    "api:build": "nx run api:build",
    "api:start": "node dist/apps/api/main.js",
    "api": "nx run api:dev",
    "init": "node scripts/init.js",
    "build:preview": "nx run mobile:build-preview",
    "build": "npm run prisma:generate --workspace=api && nx run api:build",
    "dev": "node scripts/start-dev.mjs",
    "db:start": "node scripts/start-mongodb.mjs",
    "db:stop": "node scripts/stop-mongodb.mjs",
    "deploy:all": "node scripts/deploy-all.mjs",
    "doctor": "nx run mobile:doctor",
    "heroku:setup": "node scripts/setup-heroku.mjs",
    "ios": "npm --prefix apps/mobile run ios",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "mobile": "npm --prefix apps/mobile run dev",
    "start": "nx run-many --target=dev --projects=mobile,api --parallel",
    "test:coverage": "nx run mobile:test-coverage",
    "test:all": "nx run-many --target=test --projects=api,mobile --parallel=1",
    "test": "nx run mobile:test",
    "typecheck": "nx run-many --target=typecheck --projects=shared-types,mobile,api --parallel",
    "validate:startup": "node ./scripts/startup-validate.mjs",
    "validate:mobile": "nx run mobile:validate",
    "web": "npm --prefix apps/mobile run web"
  },
  "jest": {
    "preset": "jest-expo",
    "rootDir": "apps/mobile",
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "html",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "moduleNameMapper": {
      "^@expo-50sdk-template/logging$": "<rootDir>/../../libs/logging/src/index.ts",
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "<rootDir>/jest-setup.ts"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^4.21.2",
    "express-oauth2-jwt-bearer": "^1.7.1",
    "jose": "^4.15.9",
    "prisma": "^5.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "^18.0.7",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^16.1.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "expo-doctor": "^1.11.0",
    "jest": "^29.7.0",
    "jest-expo": "~50.0.4",
    "nx": "23.3.1",
    "postcss": "8.5.31",
    "prettier": "^3.2.5",
    "react-test-renderer": "18.2.0",
    "tar": "7.5.22",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.7"
    },
    "@xmldom/xmldom": "0.8.15",
    "image-size": "1.2.1",
    "postcss": "8.5.31",
    "tar": "7.5.22",
    "undici": "7.30.1"
  },
  "private": true,
  "engines": {
    "node": ">=20.12.0 <23",
    "npm": ">=10"
  },
  "template": {
    "description": "Expo SDK 50 starter shell with reusable app architecture and a neutral landing/settings flow.",
    "sampleDomain": [
      "starter home screen",
      "starter settings screen",
      "generic feature cards"
    ],
    "reusableShell": [
      "expo-router",
      "redux-toolkit",
      "persisted state",
      "gluestack-ui",
      "shared utilities and hooks"
    ],
    "appSpecificPackages": [
      "expo-camera",
      "expo-barcode-scanner",
      "expo-share-intent",
      "sample task-domain modules"
    ]
  }
}

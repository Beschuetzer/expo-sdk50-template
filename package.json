{
  "name": "expo-50sdk-template",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "android": "npm --prefix apps/mobile run android",
    "api:build": "nx run api:build",
    "api:start": "node dist/apps/api/main.js",
    "api": "nx run api:dev",
    "idp": "nx run identity-provider:dev",
    "idp:build": "nx run identity-provider:build",
    "idp:start": "nx run identity-provider:serve",
    "init": "node scripts/init.js",
    "build:preview": "nx run mobile:build-preview",
    "build": "nx run-many --target=build --projects=api,identity-provider --parallel",
    "dev": "node scripts/start-dev.mjs",
    "doctor": "nx run mobile:doctor",
    "heroku:setup": "node scripts/setup-heroku.mjs",
    "ios": "npm --prefix apps/mobile run ios",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "mobile": "npm --prefix apps/mobile run dev",
    "start": "nx run-many --target=dev --projects=mobile,api,identity-provider --parallel",
    "test:coverage": "nx run mobile:test-coverage",
    "test:all": "nx run-many --target=test --projects=api,identity-provider,mobile --parallel=1",
    "test": "nx run mobile:test",
    "typecheck": "nx run-many --target=typecheck --projects=shared-types,mobile,api,identity-provider --parallel",
    "validate:startup": "node ./scripts/startup-validate.mjs",
    "validate:mobile": "nx run mobile:validate",
    "web": "npm --prefix apps/mobile run web"
  },
  "jest": {
    "preset": "jest-expo",
    "rootDir": "apps/mobile",
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "html",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "<rootDir>/jest-setup.ts"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@expo/vector-icons": "^14.0.4",
    "@gluestack-style/react": "1.0.57",
    "@gluestack-ui/config": "1.1.20",
    "@gluestack-ui/themed": "1.1.73",
    "@gorhom/bottom-sheet": "^4.6.1",
    "@react-native-aria/interactions": "^0.2.16",
    "@react-native-aria/overlays": "^0.3.15",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-community/netinfo": "11.1.0",
    "@react-navigation/native": "^6.0.2",
    "@reduxjs/toolkit": "^2.1.0",
    "@shopify/flash-list": "1.6.3",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.75.5",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "expo": "~50.0.20",
    "expo-barcode-scanner": "~12.9.3",
    "expo-blur": "~12.9.2",
    "expo-camera": "~14.1.3",
    "expo-checkbox": "~2.7.0",
    "expo-constants": "~15.4.6",
    "expo-dev-client": "~3.3.12",
    "expo-document-picker": "~11.10.1",
    "expo-file-system": "~16.0.9",
    "expo-font": "~11.10.3",
    "expo-haptics": "~12.8.1",
    "expo-image": "~1.10.6",
    "expo-image-picker": "~14.7.1",
    "expo-auth-session": "~5.4.0",
    "expo-linking": "~6.2.2",
    "expo-localization": "~15.0.3",
    "expo-location": "~16.5.5",
    "expo-media-library": "~15.9.2",
    "expo-notifications": "~0.27.8",
    "expo-router": "~3.5.24",
    "expo-secure-store": "~13.0.2",
    "expo-share-intent": "^1.9.0",
    "expo-splash-screen": "^0.27.7",
    "expo-status-bar": "~1.11.1",
    "expo-system-ui": "~2.9.4",
    "expo-web-browser": "~12.8.2",
    "express": "^4.21.2",
    "express-oauth2-jwt-bearer": "^1.7.1",
    "jose": "^4.15.9",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-popup-menu": "^0.16.1",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-web": "~0.19.6",
    "react-redux": "^9.1.0",
    "redux-devtools-expo-dev-plugin": "0.2.1",
    "redux-persist": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "^18.0.7",
    "eslint": "^8.56.0",
    "eslint-config-universe": "^12.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "expo-doctor": "^1.11.0",
    "jest": "^29.7.0",
    "jest-expo": "~50.0.4",
    "nx": "23.2.1",
    "prisma": "^5.22.0",
    "prettier": "^3.2.5",
    "react-test-renderer": "18.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.1.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.11.0 <23",
    "npm": ">=10"
  },
  "template": {
    "description": "Expo SDK 50 starter shell with reusable app architecture and a neutral landing/settings flow.",
    "sampleDomain": [
      "starter home screen",
      "starter settings screen",
      "generic feature cards"
    ],
    "reusableShell": [
      "expo-router",
      "redux-toolkit",
      "persisted state",
      "gluestack-ui",
      "shared utilities and hooks"
    ],
    "appSpecificPackages": [
      "expo-camera",
      "expo-barcode-scanner",
      "expo-share-intent",
      "sample task-domain modules"
    ]
  }
}

{
  "name": "mobile",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-50sdk-template/logging": "1.0.0"
  },
  "scripts": {
    "dev": "node setup.mjs && node ../../scripts/start-expo.mjs start",
    "dev:clear": "node setup.mjs && node ../../scripts/start-expo.mjs start --clear",
    "android": "node setup.mjs && node ../../scripts/start-expo.mjs start --android",
    "ios": "node setup.mjs && node ../../scripts/start-expo.mjs start --ios",
    "web": "node setup.mjs && node ../../scripts/start-expo.mjs start --web",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "doctor": "expo-doctor",
    "build-preview": "eas build -p android --profile preview"
  }
}

# Prisma / MongoDB
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority"

# API runtime
NODE_ENV="development"
HOST="0.0.0.0"
PORT="4200"
CORS_ORIGIN="http://localhost:8081"

# OAuth2 / resource-server auth
AUTH_ISSUER_BASE_URL="https://identity-beta.adammajor.com"
AUTH_AUDIENCE="api"
AUTH_REQUIRED_SCOPES=""
